flowchart TB
    subgraph FREE["Free, forever"]
        direction TB
        F1["Her own link, unlimited bookings"]
        F2["Email confirmations, both sides"]
        F3["Her photographs on every treatment"]
        F4["Patch tests enforced, and a dated record"]
        F5["Her client list, with private notes"]
        F6["Clients cancel themselves, inside her window"]
        F7["Story cards in her trade's colours, no mark"]
    end

    subgraph PRO["Pro, £10 a month"]
        direction TB
        P1["Everything in Free"]
