        P3["Rebooking, so clients hear when they are due"]
        P4["Reminders before every appointment"]
    end

    subgraph PLUS["Pro+, £24 a month"]
        direction TB
        X1["Everything in Pro"]
        X2["A waiting list that fills her cancellations"]
        X3["Standing appointments, six visits in one go"]
        X4["Lapsed patch tests chased for her"]
        X5["The insurance pack<br/><i>every dated test and appointment, in one tap</i>"]
    end

    subgraph NOT["Written down, not built"]
        direction TB
        N1["Consent forms"]
        N2["Travel-time buffers"]
        N3["Her own domain name"]
        N4["Rescheduling<br/><i>today it is cancel, then rebook</i>"]
        N5["Posting a Story straight to Instagram"]
    end

    FREE --> PRO --> PLUS --> NOT

